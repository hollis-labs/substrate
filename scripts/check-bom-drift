#!/bin/sh
# check-bom-drift: fail when bom/bom.yaml disagrees with Folio's
# platform-pins.yaml, which is canonical for portfolio-wide pins.
#
#   check-bom-drift <folio-dir-or-platform-pins.yaml>
#
# Checks: every `ci` pin in the BOM equals Folio's, and the BOM's toolchain
# go_min is not below Folio's go.version floor. Not run in CI (Folio is not
# fetchable there); run it locally before changing either file.
# Exit: 0 pass · 1 drift · 2 usage.
set -u
[ $# -eq 1 ] || { echo "usage: $0 <folio-dir|platform-pins.yaml>" >&2; exit 2; }
pins=$1
[ -d "$pins" ] && pins=$pins/platform-pins.yaml
[ -f "$pins" ] || { echo "not found: $pins" >&2; exit 2; }
bom=$(cd "$(dirname "$0")/.." && pwd)/bom/bom.yaml

# val FILE SECTION KEY: value of `  KEY: "v"` under top-level `SECTION:`.
val() {
	awk -v sec="$2" -v key="$3" '
		/^[^ #]/ { insec = ($1 == sec ":") }
		insec && $1 == key ":" { v = $2; gsub(/"/, "", v); print v; exit }' "$1"
}

fail=0
for k in actions_checkout actions_setup_go golangci_lint_action golangci_lint_version govulncheck_version; do
	a=$(val "$bom" ci "$k"); b=$(val "$pins" ci "$k")
	if [ -n "$a" ] && [ "$a" = "$b" ]; then echo "PASS ci.$k $a"; else echo "FAIL ci.$k bom=$a folio=$b"; fail=1; fi
done

min=$(val "$bom" toolchain go_min); floor=$(val "$pins" go version)
if [ -n "$min" ] && [ -n "$floor" ] && [ "$(printf '%s\n%s\n' "$floor" "$min" | sort -V | head -1)" = "$floor" ]; then
	echo "PASS go_min $min >= floor $floor"
else
	echo "FAIL go_min bom=$min folio_floor=$floor"; fail=1
fi
exit $fail
