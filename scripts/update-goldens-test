#!/usr/bin/env python3
"""Offline regression checks for the updater's scan-before-publish boundary."""
import contextlib
import io
import os
from pathlib import Path
import runpy
import subprocess
import tempfile
import unittest
from unittest.mock import patch

API = runpy.run_path(str(Path(__file__).with_name("update-goldens")))

class ScannerBoundary(unittest.TestCase):
    def test_empty_scan_fails_closed(self):
        # Reproduce git discovery swallowing an ignored staging directory.
        with tempfile.TemporaryDirectory(dir=os.environ.get("TMPDIR")) as temporary:
            root = Path(temporary)
            subprocess.run(["git", "init", "-q", str(root)], check=True)
            (root / ".gitignore").write_text("candidate/\n")
            candidate = root / "candidate"
            candidate.mkdir()
            (candidate / "fixture.json").write_text('"fixture"\n')
            with self.assertRaisesRegex(RuntimeError, "zero files"):
                API["scan_candidate"](candidate, dict(os.environ))

    def test_scan_reason_is_reported(self):
        fake = subprocess.CompletedProcess([], 1, "RESULT: rejected fixture\n", "scanner detail\n")
        stream = io.StringIO()
        with patch("subprocess.run", return_value=fake), contextlib.redirect_stderr(stream):
            with self.assertRaises(RuntimeError):
                API["scan_candidate"](Path("unused"), dict(os.environ))
        self.assertIn("rejected fixture", stream.getvalue())
        self.assertIn("scanner detail", stream.getvalue())

if __name__ == "__main__":
    unittest.main()
