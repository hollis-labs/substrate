{
  "name": "{{ .inputs.repo_name }}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ui:verify": "surface-ui verify",
    "ui:status": "surface-ui status"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
{{- if eq .inputs.kind "desk" }}
    "@hollis-labs/surface-cards": "{{ .inputs.surface_version }}",
    "@hollis-labs/surface-chat": "{{ .inputs.surface_version }}",
    "@hollis-labs/surface-genui": "{{ .inputs.surface_version }}",
    "@hollis-labs/surface-page": "{{ .inputs.surface_version }}",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "flexlayout-react": "0.11.2",
{{- else }}
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
{{- end }}
    "lucide-react": "1.74.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
{{- if eq .inputs.kind "desk" }}
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.24.0",
    "remark-gfm": "4.0.1",
{{- else }}
    "react-resizable-panels": "4.24.0",
{{- end }}
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@hollis-labs/surface-ui": "{{ .inputs.surface_version }}",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
