name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
{{- if eq .inputs.kind "desk" }}
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
{{- end }}
      - name: npm ci (commit package-lock.json after `make setup`)
        run: npm ci
      # Required: every installed component must match the Surface registry at the lock's ref.
      - name: surface-ui verify
        run: npx surface-ui verify
      - name: lint (no raw controls in views)
        run: npm run lint
      - name: typecheck
        run: npm run typecheck
      - name: build
        run: npm run build
{{- if eq .inputs.kind "desk" }}
      - name: go vet
        run: go vet ./...
      - name: go test
        run: go test ./...
      - name: go build
        run: go build -o {{ .inputs.repo_name }} .
{{- end }}
