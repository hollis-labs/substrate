.PHONY: setup check build dev typecheck lint ui-verify ui-sync ui-status
{{- if eq .inputs.kind "desk" }} serve vet test go-build{{ end }}

# The registry items this app installs. surface-ui adds what each depends on and records every file's
# hash in ui.lock.json. To use another component: `npx surface-ui add <name>`, then commit what it wrote.
{{- if eq .inputs.kind "desk" }}
# A desk app installs what @hollis-labs/surface-page draws with, and the rest of the registry, because
# the Components window (the gallery) draws every item. This list is the registry at {{ .computed.surface_ref }}.
UI_ITEMS := --for @hollis-labs/surface-page theme avatar breadcrumb card-frame checkbox collapsible \
	context-menu field input-group popover progress resizable scroll-area separator sheet skeleton \
	table tabs text-editor textarea toggle toggle-group tooltip
{{- else }}
UI_ITEMS := theme app-frame button input dialog card
{{- end }}

# Once, after `folio new`: install the packages and the components, then commit everything it wrote
# (package-lock.json, ui.lock.json, src/components/{{ if eq .inputs.kind "desk" }}, go.sum{{ end }}).
setup:
	npm install
	npx surface-ui add $(UI_ITEMS)
{{- if eq .inputs.kind "desk" }}
	go mod tidy
{{- end }}

# What CI runs.
check: ui-verify lint typecheck build{{ if eq .inputs.kind "desk" }} vet test go-build{{ end }}

build:
	npm run build

dev:
	npm run dev

typecheck:
	npm run typecheck

lint:
	npm run lint

# Fails when an installed component differs from the registry at the lock's ref: a look is changed in
# the registry, never here.
ui-verify:
	npx surface-ui verify

# After moving "ref" in ui.lock.json and the @hollis-labs/surface-* versions to a new Surface release.
ui-sync:
	npx surface-ui sync

ui-status:
	npx surface-ui status
{{- if eq .inputs.kind "desk" }}

vet:
	go vet ./...

test:
	go test ./...

# The binary embeds the page built into webui/dist, so build the page first.
go-build:
	go build -o {{ .inputs.repo_name }} .

# The app on 127.0.0.1:{{ .inputs.port }}. Its data is in .data/ unless {{ .computed.env_prefix }}_DATA_DIR says otherwise.
DATA_DIR ?= .data
serve: build go-build
	{{ .computed.env_prefix }}_DATA_DIR=$(DATA_DIR) ./{{ .inputs.repo_name }} serve
{{- end }}
