// Command {{ .inputs.repo_name }} is a Surface desk app: the Surface core and this app's modules.
//
// A module registers itself when imported; add one by importing it below and naming it in modules.
package main

import (
	"context"

	"github.com/hollis-labs/substrate/module"

	"github.com/hollis-labs/surface/app"

	"{{ .computed.module_path }}/internal/agentdir"
	"{{ .computed.module_path }}/webui"

	// Substrate's mechanism: config, logging, health, the database handle, the CLI, HTTP.
	_ "github.com/hollis-labs/substrate/modules/cli"
	_ "github.com/hollis-labs/substrate/modules/config"
	_ "github.com/hollis-labs/substrate/modules/database"
	_ "github.com/hollis-labs/substrate/modules/health"
	_ "github.com/hollis-labs/substrate/modules/httphost"
	_ "github.com/hollis-labs/substrate/modules/logging"

	// This app's modules.
	_ "{{ .computed.module_path }}/modules/start"
)

// modules is the start order of this app's modules.
var modules = []string{"start"}

func main() {
	assets, _ := webui.Assets()
	app.Main(app.Config{
		Name:                "{{ .inputs.repo_name }}",
		Title:               {{ quote .computed.app_title }},
		Modules:             modules,
		SubstrateModules:    []string{"config", "agent-directory", "logging", "health", "database", "cli", "httphost"},
		SubstrateConfigJSON: `{"agents":{"dir":"agents/"},"database":{"sqlite":{"path":"surface.db"}},"httphost":{"addr":"127.0.0.1:{{ .inputs.port }}"},"logging":{"format":"text","level":"info"}}`,
		Assets:              assets,
	})
}

// Resolve after Substrate has merged SUBSTRATE_CONFIG. This only publishes paths;
// the app does not open agent definitions or start a Nanite runtime yet.
func init() { module.Register(agentDirectory{}) }

type agentDirectory struct{}

func (agentDirectory) Name() string                                   { return "agent-directory" }
func (agentDirectory) Start(_ context.Context, app *module.App) error { return agentdir.Resolve(app) }
func (agentDirectory) Stop(context.Context) error                     { return nil }
