// Package start is this app's first module: one window and one agent tool. Replace it with the app's own
// work, or keep it as the pattern for the next module. The guide is docs/writing-a-module.md in
// github.com/hollis-labs/surface.
package start

import (
	"context"
	"encoding/json"
	"strings"

	"github.com/hollis-labs/surface/module"
)

func init() { module.Register(&mod{}) }

type mod struct{ module.Base }

func (m *mod) Manifest() module.Manifest {
	return module.Manifest{
		ID: "start", Title: "Start", Version: "0.1.0",
		About: "The app's first window: where its own work begins.",
		Views: []module.View{{ "{{" }}
			ID: "start", Title: "Start", Icon: "sparkles", Width: 480, Height: 360, Menu: true,
			// The page's component for this view: src/modules/start.tsx, key "start/main".
			Render: module.Component("start/main"),
		{{ "}}" }},
		Tools: []module.Tool{{ "{{" }}
			Name:        "start_greet",
			Description: "Greet someone by name. The example tool: tools are Go, and the agent, the palette and outside agents over MCP all call the same one.",
			Level:       module.LevelRead,
			Input:       json.RawMessage(`{"type":"object","required":["name"],"properties":{"name":{"type":"string"}}}`),
			Run: func(_ context.Context, _ module.Host, in json.RawMessage) (any, error) {
				var a struct{ Name string }
				if err := json.Unmarshal(in, &a); err != nil {
					return nil, err
				}
				return Greeting(a.Name), nil
			},
		{{ "}}" }},
	}
}

// Greeting is what start_greet answers.
func Greeting(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		name = "there"
	}
	return "Hello, " + name + "."
}
