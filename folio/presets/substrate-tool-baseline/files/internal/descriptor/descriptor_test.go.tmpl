var portOf = regexp.MustCompile(`^http://127\.0\.0\.1:([0-9]+)/healthz$`)

// TestDriftPairs checks the pairs that must not diverge between project.yaml, deploy.yaml and the Cerberus
// manifest (Option B: fleet-install places the binary, Cerberus supervises it).
func TestDriftPairs(t *testing.T) {
	p, err := Load(filepath.Join(root(t), "project.yaml"))
	if err != nil {
		t.Fatal(err)
	}
	if p.Deploy == nil {
		t.Fatal("class 2 daemons require deployment metadata")
	}
	if p.Deploy.Cerberus != app+".cerberus.yaml" {
		t.Fatalf("project.yaml deploy.cerberus = %q, want %s.cerberus.yaml", p.Deploy.Cerberus, app)
	}
	d := readYAML(t, p.Deploy.Fleet)
	c := readYAML(t, p.Deploy.Cerberus)

	// project.id == cerberus owner == cerberus project.id.
	if c["owner"] != p.ID || at(t, c, "project", "id") != p.ID {
		t.Errorf("cerberus owner %v / project.id %v must equal project.yaml id %q", c["owner"], at(t, c, "project", "id"), p.ID)
	}
	// command[0] == deploy.yaml symlink path.
	link := at(t, d, "targets", 0, "symlinks", 0, "path")
	if cmd := at(t, c, "resources", 0, "config", "command", 0); cmd != link {
		t.Errorf("cerberus command[0] = %v, deploy.yaml symlink = %v", cmd, link)
	}
	// restart.via == cerberus and names the resource id.
	if via := at(t, d, "targets", 0, "restart", "via"); via != "cerberus" {
		t.Errorf("deploy.yaml restart.via = %v, want cerberus", via)
	}
	rid := at(t, c, "resources", 0, "id")
	if res := at(t, d, "targets", 0, "restart", "resource"); res != rid {
		t.Errorf("deploy.yaml restart.resource = %v, cerberus resource id = %v", res, rid)
	}
	// Option B: no build, no artifact_path, run from the workspace.
	cfg := at(t, c, "resources", 0, "config").(map[string]any)
	for _, k := range []string{"build_strategy", "artifact_path"} {
		if _, ok := cfg[k]; ok {
			t.Errorf("cerberus config has %s: under Option B fleet-install places the binary", k)
		}
	}
	if cfg["run_from"] != "workspace" {
		t.Errorf("cerberus run_from = %v, want workspace", cfg["run_from"])
	}
	// port / url == health.url.
	health, _ := at(t, d, "targets", 0, "health", "url").(string)
	m := portOf.FindStringSubmatch(health)
	if m == nil {
		t.Fatalf("deploy.yaml health.url = %q, want http://127.0.0.1:<port>/healthz", health)
	}
	if cfg["url"] != health || at(t, cfg, "health_check", "url") != health {
		t.Errorf("cerberus url %v / health_check.url %v must equal deploy.yaml health.url %q", cfg["url"], at(t, cfg, "health_check", "url"), health)
	}
	if port := cfg["port"]; fmt.Sprint(port) != m[1] {
		t.Errorf("cerberus port = %v, health.url port = %s", port, m[1])
	}

}

// TestDeclaredAuthMatchesDefault: the mode project.yaml declares is the mode the binary defaults to.
func TestDeclaredAuthMatchesDefault(t *testing.T) {
	p, err := Load(filepath.Join(root(t), "project.yaml"))
	if err != nil {
		t.Fatal(err)
	}
	var declared string
	for _, i := range p.Interfaces {
		if i.Type == "daemon" || i.Type == "api" {
			declared = i.Auth
		}
	}
	if declared != string(authmode.Default) {
		t.Errorf("project.yaml declares auth %q, authmode.Default is %q", declared, authmode.Default)
	}
}
