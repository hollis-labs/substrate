name: build
# Release recipe (class 2: tags optional): publishes the release tarballs and SHA256SUMS as workflow
# artifacts (no tag, no release, no install) that `fleet-install` reads; deploy.yaml rides inside the
# selected target tarball. Signing is a later step.
on:
  push: { branches: [main] }
  pull_request: { branches: [main] }
  workflow_dispatch:
permissions: { contents: read }
jobs:
  build:
    uses: hollis-labs/tools/.github/workflows/go-app-build.yml@{{ .inputs.build_workflow_ref }}
    with:
      app: {{ .inputs.repo_name }}
      targets: '["{{ .inputs.target_os }}/{{ .inputs.target_arch }}"]'
      main_pkg: ./cmd/{{ .inputs.repo_name }}
      test_cmd: "go vet ./... && go test -race -count=1 ./..."
      extra_files: deploy.yaml project.yaml
