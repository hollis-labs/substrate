{{- if eq .inputs.tool_kind "service" -}}
# {{ .computed.app_title }} under Cerberus (cerberus-project/v1), Option B: fleet-install places the binary (deploy.yaml)
# and Cerberus only supervises it. So: run_from workspace, command[0] is the fleet-install link path, and there is
# no build_strategy and no artifact_path (artifact_path is where Cerberus COPIES a built binary; pointing it at the
# link would overwrite fleet-install's link).
#
# Register: `cerberus register {{ .inputs.repo_name }}.cerberus.yaml`, then `cerberus resource apply {{ .inputs.repo_name }} --ack`.
# Check:    `cerberus validate {{ .inputs.repo_name }}.cerberus.yaml`
kind: cerberus-project/v1
owner: {{ .inputs.repo_name }}
namespace: local
project:
  id: {{ .inputs.repo_name }}
  name: {{ .computed.app_title }}
resources:
  - id: {{ .inputs.repo_name }}
    name: {{ .computed.app_title }}
    type: process
    project: {{ .inputs.repo_name }}
    connector: local
    config:
      command:
        - ~/.local/bin/{{ .inputs.repo_name }}
        - serve
      mode: os_service
      port: {{ .inputs.http_port }}
      run_from: workspace
      supervisor: systemd_user
      url: http://127.0.0.1:{{ .inputs.http_port }}/healthz
      health_check:
        url: http://127.0.0.1:{{ .inputs.http_port }}/healthz
    tags:
      - api
      - go
      - daemon
      - {{ .inputs.repo_name }}
{{- end }}
