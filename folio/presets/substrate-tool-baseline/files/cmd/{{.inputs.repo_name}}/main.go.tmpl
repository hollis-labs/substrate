// Command {{ .inputs.repo_name }} is a class 2 tool built on Substrate. The shell (config, logging, health{{ if eq .inputs.tool_kind "service" }}, HTTP{{ else }}, CLI skeleton{{ end }})
// comes from the manifest; this package and internal/ are the tool.
package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/spf13/cobra"

	"github.com/hollis-labs/substrate/boot"
	"github.com/hollis-labs/substrate/module"
	"github.com/hollis-labs/substrate/modules/cli"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	if err := run(ctx); err != nil {
		fmt.Fprintln(os.Stderr, "{{ .inputs.repo_name }}:", err)
		stop()
		os.Exit(1)
	}
}

func run(ctx context.Context) error {
	started, err := boot.Start(ctx, substrateApp, substrateModules, substrateConfigJSON)
	if err != nil {
		return err
	}
	defer func() { _ = started.Stop(context.Background()) }()
	return newRoot(ctx, started.App).ExecuteContext(ctx)
}

// newRoot is the command tree over the started app: Substrate supplies version, config and health.
func newRoot(ctx context.Context, app *module.App) *cobra.Command {
	root := cli.Root(app)
{{- if eq .inputs.tool_kind "service" }}
	root.AddCommand(serveCmd(ctx, app))
{{- else }}
	root.AddCommand(&cobra.Command{
		Use:   "hello",
		Short: "Say hello (replace with the tool's commands)",
		Args:  cobra.NoArgs,
		Run:   func(c *cobra.Command, _ []string) { _, _ = fmt.Fprintln(c.OutOrStdout(), "hello") },
	})
{{- end }}
	return root
}
