func mcpApp(t *testing.T) *module.App {
	t.Helper()
	t.Setenv("SUBSTRATE_CONFIG", "")
	t.Setenv("{{ .computed.env_prefix }}_TOKEN", "test-service-credential")
	run, err := boot.StartWith(context.Background(), substrateApp, substrateModules, substrateConfigJSON, boot.Options{AfterConfig: func(ctx context.Context, app *module.App) error {
		if err := configureMCP(ctx, app); err != nil {
			return err
		}
		cfg := app.Config["auth"].(map[string]any)
		keys, _ := cfg["api_keys"].([]any)
		cfg["api_keys"] = append(keys,
			map[string]any{"id": "configured", "hash": libauth.HashKey("configured-credential"), "scopes": []any{app.Name + ".mcp", app.Name + ".read"}},
			map[string]any{"id": "limited", "hash": libauth.HashKey("limited-credential"), "scopes": []any{app.Name + ".read"}},
		)
		return nil
	}})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = run.Stop(context.Background()) })
	registerMCP(run.App)
	return run.App
}

func TestMCPHTTPRequiresCredentialAndScope(t *testing.T) {
	app := mcpApp(t)
	handler, err := httphost.Handler(app, httphost.Options{})
	if err != nil {
		t.Fatal(err)
	}
	for _, token := range []string{"", "wrong", "test-service-credential", "configured-credential", "limited-credential"} {
		req := httptest.NewRequest("POST", "/mcp", strings.NewReader(`{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"ping","arguments":{}}}`))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Accept", "application/json, text/event-stream")
		if token != "" {
			req.Header.Set("Authorization", "Bearer "+token)
		}
		rec := httptest.NewRecorder()
		handler.ServeHTTP(rec, req)
		if token == "test-service-credential" || token == "configured-credential" {
			if rec.Code != 200 || !strings.Contains(rec.Body.String(), "pong") {
				t.Fatalf("authenticated MCP: %d %s", rec.Code, rec.Body)
			}
		} else if token == "limited-credential" {
			if rec.Code != 403 {
				t.Fatalf("insufficient scope: %d", rec.Code)
			}
		} else if rec.Code != 401 {
			t.Fatalf("invalid credential: %d", rec.Code)
		}
	}
}

func mcpConnect(t *testing.T, app *module.App, o mcp.StdioOptions) *mcpsdk.ClientSession {
	t.Helper()
	srvIn, cliOut := io.Pipe()
	cliIn, srvOut := io.Pipe()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	t.Cleanup(cancel)
	t.Cleanup(func() { _ = srvIn.Close(); _ = cliOut.Close(); _ = cliIn.Close(); _ = srvOut.Close() })
	o.In, o.Out, o.Notice = srvIn, srvOut, io.Discard
	go func() { _ = mcp.ServeStdio(ctx, app, o); _ = srvOut.Close() }()
	cs, err := mcpsdk.NewClient(&mcpsdk.Implementation{Name: "test", Version: "1"}, nil).Connect(ctx, &mcpsdk.IOTransport{Reader: cliIn, Writer: cliOut}, nil)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = cs.Close() })
	return cs
}

func TestMCPLocalTrustRetainsToolScopes(t *testing.T) {
	app := mcpApp(t)
	o := localStdioOptions(app, "", true)
	cs := mcpConnect(t, app, o)
	result, err := cs.CallTool(context.Background(), &mcpsdk.CallToolParams{Name: "ping"})
	if err != nil || result.IsError {
		t.Fatalf("local read: %v %v", result, err)
	}
	o.LocalScopes = []string{app.Name + ".mcp"}
	cs = mcpConnect(t, app, o)
	result, err = cs.CallTool(context.Background(), &mcpsdk.CallToolParams{Name: "ping"})
	if err == nil && !result.IsError {
		t.Fatal("endpoint scope alone authorized read tool")
	}
	// No local trust by default; an explicit bad token never falls back to it.
	if err := mcp.ServeStdio(context.Background(), app, localStdioOptions(app, "", false)); err == nil {
		t.Fatal("stdio without credentials or local trust accepted")
	}
	file := filepath.Join(t.TempDir(), "credential")
	if err := os.WriteFile(file, []byte("wrong"), 0o600); err != nil {
		t.Fatal(err)
	}
	if err := mcp.ServeStdio(context.Background(), app, localStdioOptions(app, file, true)); err == nil {
		t.Fatal("bad token fell back to local trust")
	}
}

func TestMCPRefusesAuthDowngrade(t *testing.T) {
	app := &module.App{Name: substrateApp, Config: map[string]any{"auth": map[string]any{"mode": "off"}}}
	if err := configureMCP(context.Background(), app); err == nil {
		t.Fatal("auth downgrade accepted")
	}
	// Anonymous execution cannot call the registered tool directly either.
	app = mcpApp(t)
	if err := mcp.Authorize(context.Background(), app, "ping"); err == nil {
		t.Fatal("anonymous tool call accepted")
	}
}
