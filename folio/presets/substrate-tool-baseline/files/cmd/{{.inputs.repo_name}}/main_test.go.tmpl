package main

import (
{{- if eq .inputs.tool_kind "cli" }}
	"bytes"
{{- end }}
	"context"
	"testing"

	"github.com/hollis-labs/substrate/boot"
)

func TestRootHasCommands(t *testing.T) {
	ctx := context.Background()
	run, err := boot.Start(ctx, substrateApp, substrateModules, substrateConfigJSON)
	if err != nil {
		t.Fatal(err)
	}
	defer func() { _ = run.Stop(ctx) }()
	root := newRoot(ctx, run.App)
	for _, name := range []string{"version", "{{ if eq .inputs.tool_kind "service" }}serve{{ else }}hello{{ end }}"} {
		if c, _, err := root.Find([]string{name}); err != nil || c == root {
			t.Errorf("command %q missing: %v", name, err)
		}
	}
{{- if eq .inputs.tool_kind "cli" }}
	var out bytes.Buffer
	root.SetOut(&out)
	root.SetArgs([]string{"hello"})
	if err := root.ExecuteContext(ctx); err != nil {
		t.Fatal(err)
	}
	if out.String() != "hello\n" {
		t.Errorf("hello printed %q", out.String())
	}
{{- end }}
}
