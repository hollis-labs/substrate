# Authored project/1 descriptor; Folio never overwrites it.
schema: project/1
id: {{ .inputs.repo_name }}
name: {{ .computed.app_title }}
description: {{ if .inputs.description }}{{ .inputs.description | quote }}{{ else }}"TODO(author): one line"{{ end }}
class: 1
lifecycle: experimental
visibility: public
owner: {{ .inputs.owner }}
operator: {{ .inputs.operator }}
org: {{ .inputs.github_owner }}
repo: https://github.com/{{ .inputs.github_owner }}/{{ .computed.repository_slug }}
location: {{ .inputs.repository_location }}
interfaces:
  - { type: daemon, name: {{ .inputs.repo_name }}, auth: enforce }
  - { type: api, name: {{ .inputs.repo_name }} API, auth: enforce }
  - { type: mcp, name: {{ .inputs.repo_name }} MCP, auth: enforce }
{{- if .inputs.with_frontend }}
  - { type: gui, name: {{ .inputs.repo_name }} UI, auth: enforce }
{{- end }}
substrate: { variant: app-host, profile: agentic, version: {{ .inputs.substrate_version }} }
deploy: { fleet: deploy.yaml, cerberus: {{ .inputs.repo_name }}.cerberus.yaml }
release: { tagging: semver }
settings:
  runtime:
    target_os: {{ .inputs.target_os }}
    target_arch: {{ .inputs.target_arch }}
    host: {{ .inputs.deploy_host }}
    http_port: {{ .inputs.http_port }}
    binary_link: ~/.local/bin/{{ .inputs.repo_name }}
    install_root: ~/.local/share/fleet/releases/{{ .inputs.repo_name }}
    backup_database: ~/.local/share/{{ .inputs.repo_name }}/{{ .inputs.repo_name }}.db
