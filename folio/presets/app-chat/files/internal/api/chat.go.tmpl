package api

import (
	"context"
	"encoding/json"
	"errors"
	"io"
	"net/http"
	"strconv"
	"strings"

	"{{ .computed.module_path }}/internal/service"
	"github.com/hollis-labs/substrate/apierr"
)

type chatService interface {
	ListConversations(context.Context, string) ([]service.Conversation, error)
	CreateConversation(context.Context, string, string) (int64, error)
	ListMessages(context.Context, string, int64) ([]service.Message, error)
	SendMessage(context.Context, string, int64, string) (bool, error)
	AssistantConnected() bool
}

func chatRoutes() []Route {
	return []Route{
		{http.MethodGet, "/api/conversations", ScopeRead},
		{http.MethodPost, "/api/conversations", ScopeWrite},
		{http.MethodGet, "/api/conversations/{conversation}/messages", ScopeRead},
		{http.MethodPost, "/api/conversations/{conversation}/messages", ScopeWrite},
	}
}

func (h *Handler) registerChat(mux *http.ServeMux) {
	for _, rt := range chatRoutes() {
		mux.HandleFunc(rt.Method+" "+rt.Pattern, h.chat)
	}
}

func decodeChat(w http.ResponseWriter, r *http.Request, v any) bool {
	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16<<10))
	dec.DisallowUnknownFields()
	if err := dec.Decode(v); err != nil {
		return false
	}
	return errors.Is(dec.Decode(new(any)), io.EOF)
}

func (h *Handler) chat(w http.ResponseWriter, r *http.Request) {
	who, ok := owner(r)
	if !ok {
		apierr.Write(w, http.StatusUnauthorized, "unauthorized", "Sign in required", nil)
		return
	}
	svc, ok := h.items.(chatService)
	if !ok {
		apierr.Write(w, http.StatusInternalServerError, "internal", "Chat is unavailable", nil)
		return
	}
	idText := r.PathValue("conversation")
	if idText == "" {
		h.conversations(w, r, svc, who)
		return
	}
	id, err := strconv.ParseInt(idText, 10, 64)
	if err != nil || id < 1 {
		apierr.Write(w, http.StatusBadRequest, "invalid_request", "Invalid conversation", nil)
		return
	}
	if r.Method == http.MethodGet {
		messages, listErr := svc.ListMessages(r.Context(), who, id)
		if chatError(w, listErr) {
			return
		}
		writeJSON(w, http.StatusOK, map[string]any{"messages": messages, "assistant_connected": svc.AssistantConnected()})
		return
	}
	var in struct {
		Content string `json:"content"`
	}
	if !decodeChat(w, r, &in) || strings.TrimSpace(in.Content) == "" || len(in.Content) > 8000 {
		apierr.Write(w, http.StatusBadRequest, "invalid_request", "content must contain 1 to 8000 bytes", nil)
		return
	}
	failed, err := svc.SendMessage(r.Context(), who, id, in.Content)
	if chatError(w, err) {
		return
	}
	writeJSON(w, http.StatusCreated, map[string]any{"saved": true, "reply_failed": failed, "assistant_connected": svc.AssistantConnected()})
}

func (h *Handler) conversations(w http.ResponseWriter, r *http.Request, svc chatService, who string) {
	if r.Method == http.MethodGet {
		conversations, err := svc.ListConversations(r.Context(), who)
		if chatError(w, err) {
			return
		}
		writeJSON(w, http.StatusOK, map[string]any{"conversations": conversations, "assistant_connected": svc.AssistantConnected()})
		return
	}
	var in struct {
		Title string `json:"title"`
	}
	if !decodeChat(w, r, &in) || strings.TrimSpace(in.Title) == "" || len(in.Title) > 200 {
		apierr.Write(w, http.StatusBadRequest, "invalid_request", "title must contain 1 to 200 bytes", nil)
		return
	}
	id, err := svc.CreateConversation(r.Context(), who, in.Title)
	if chatError(w, err) {
		return
	}
	writeJSON(w, http.StatusCreated, map[string]any{"id": id})
}

func chatError(w http.ResponseWriter, err error) bool {
	if err == nil {
		return false
	}
	if errors.Is(err, service.ErrConversationNotFound) {
		apierr.Write(w, http.StatusNotFound, "not_found", "Conversation not found", nil)
	} else {
		apierr.Write(w, http.StatusInternalServerError, "internal", "Could not save or load chat", nil)
	}
	return true
}
