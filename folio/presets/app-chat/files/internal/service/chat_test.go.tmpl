package service_test

import (
	"context"
	"database/sql"
	"errors"
	"io/fs"
	"path/filepath"
	"testing"

	"{{ .computed.module_path }}/internal/service"
	"{{ .computed.module_path }}/internal/storage"
	"github.com/pressly/goose/v3"
	_ "modernc.org/sqlite"
)

type responderFunc func(context.Context, []service.Message) (string, error)

func (f responderFunc) Reply(ctx context.Context, history []service.Message) (string, error) {
	return f(ctx, history)
}

func TestAssistantReceivesOnlyOwnedHistoryAndFailureKeepsMessage(t *testing.T) {
	ctx := context.Background()
	db, err := sql.Open("sqlite", filepath.Join(t.TempDir(), "chat.db"))
	if err != nil {
		t.Fatal(err)
	}
	defer func() { _ = db.Close() }()
	migrations, root := storage.Migrations()
	files, err := fs.Sub(migrations, root+"/sqlite")
	if err != nil {
		t.Fatal(err)
	}
	provider, err := goose.NewProvider(goose.DialectSQLite3, db, files)
	if err != nil {
		t.Fatal(err)
	}
	if _, err = provider.Up(ctx); err != nil {
		t.Fatal(err)
	}
	svc := service.New(db, db)
	first, err := svc.CreateConversation(ctx, "first", "First")
	if err != nil {
		t.Fatal(err)
	}
	second, err := svc.CreateConversation(ctx, "second", "Second")
	if err != nil {
		t.Fatal(err)
	}
	if _, err = svc.SendMessage(ctx, "second", second, "private"); err != nil {
		t.Fatal(err)
	}
	calls := 0
	svc.WithResponder(responderFunc(func(_ context.Context, history []service.Message) (string, error) {
		calls++
		if len(history) != 1 || history[0].Content != "hello" || history[0].Role != "user" {
			t.Fatalf("unexpected provider history: %#v", history)
		}
		return "reply", nil
	}))
	if _, err = svc.SendMessage(ctx, "first", second, "intrusion"); !errors.Is(err, service.ErrConversationNotFound) {
		t.Fatalf("cross-owner write: %v", err)
	}
	if calls != 0 {
		t.Fatal("unauthorized message invoked provider")
	}
	if failed, sendErr := svc.SendMessage(ctx, "first", first, "hello"); sendErr != nil || failed {
		t.Fatalf("reply: %v, %v", failed, sendErr)
	}
	history, err := svc.ListMessages(ctx, "first", first)
	if err != nil || len(history) != 2 || history[1].Content != "reply" || history[1].Role != "assistant" {
		t.Fatalf("saved reply: %#v, %v", history, err)
	}
	svc.WithResponder(responderFunc(func(context.Context, []service.Message) (string, error) {
		return "", errors.New("provider unavailable")
	}))
	if failed, sendErr := svc.SendMessage(ctx, "first", first, "save despite failure"); sendErr != nil || !failed {
		t.Fatalf("provider failure: %v, %v", failed, sendErr)
	}
	history, err = svc.ListMessages(ctx, "first", first)
	if err != nil || len(history) != 3 || history[2].Content != "save despite failure" {
		t.Fatalf("saved after failure: %#v, %v", history, err)
	}
}
