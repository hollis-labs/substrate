package service

import (
	"context"
	"errors"
	"strings"
)

// ErrConversationNotFound also covers a conversation belonging to another owner.
var ErrConversationNotFound = errors.New("conversation not found")

// Conversation is a conversation visible to its verified owner.
type Conversation struct {
	ID        int64  `json:"id"`
	Title     string `json:"title"`
	CreatedAt string `json:"created_at"`
}

// Message is persisted plain text; the caller never supplies its role or owner.
type Message struct {
	ID        int64  `json:"id"`
	Role      string `json:"role"`
	Content   string `json:"content"`
	CreatedAt string `json:"created_at"`
}

// Responder is the application-owned assistant extension. Implementations must be
// safe for concurrent calls and honor ctx. No provider is selected by the preset.
type Responder interface {
	Reply(ctx context.Context, history []Message) (string, error)
}

// WithResponder configures the assistant before serving requests. Do not change it
// while the service is running. Credentials and provider configuration belong to
// the composition root, never to browser requests.
func (s *Service) WithResponder(r Responder) *Service { s.responder = r; return s }

func (s *Service) AssistantConnected() bool { return s.responder != nil }

func (s *Service) ListConversations(ctx context.Context, owner string) ([]Conversation, error) {
	rows, err := s.read.QueryContext(ctx, `SELECT id, title, created_at FROM conversations WHERE owner = ? ORDER BY id DESC`, owner)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	out := []Conversation{}
	for rows.Next() {
		var c Conversation
		if err := rows.Scan(&c.ID, &c.Title, &c.CreatedAt); err != nil {
			return nil, err
		}
		out = append(out, c)
	}
	return out, rows.Err()
}

func (s *Service) CreateConversation(ctx context.Context, owner, title string) (int64, error) {
	result, err := s.write.ExecContext(ctx, `INSERT INTO conversations(owner, title) VALUES (?, ?)`, owner, strings.TrimSpace(title))
	if err != nil {
		return 0, err
	}
	return result.LastInsertId()
}

func (s *Service) ListMessages(ctx context.Context, owner string, conversation int64) ([]Message, error) {
	// A LEFT JOIN distinguishes an owned empty conversation from a missing or
	// inaccessible conversation without revealing which of those two applies.
	rows, err := s.read.QueryContext(ctx, `SELECT COALESCE(m.id, 0), COALESCE(m.role, ''), COALESCE(m.content, ''), COALESCE(m.created_at, '') FROM conversations c LEFT JOIN messages m ON m.conversation_id = c.id WHERE c.id = ? AND c.owner = ? ORDER BY m.id`, conversation, owner)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	out := []Message{}
	found := false
	for rows.Next() {
		found = true
		var m Message
		if err := rows.Scan(&m.ID, &m.Role, &m.Content, &m.CreatedAt); err != nil {
			return nil, err
		}
		if m.ID != 0 {
			out = append(out, m)
		}
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	if !found {
		return nil, ErrConversationNotFound
	}
	return out, nil
}

// SendMessage saves the user's message before asking an optional assistant. A
// reply error is separate from the write error so clients never retry a saved
// user message merely because a provider failed. Simultaneous sends may produce
// interleaved replies; an application needing serialized turns should add a queue.
func (s *Service) SendMessage(ctx context.Context, owner string, conversation int64, content string) (replyFailed bool, err error) {
	if err = s.insertMessage(ctx, owner, conversation, "user", content); err != nil {
		return false, err
	}
	if s.responder == nil {
		return false, nil
	}
	// The user write already succeeded. Provider errors are a reply outcome,
	// not a failed user write; the HTTP adapter reports this without retrying.
	failed := s.respond(ctx, owner, conversation) != nil
	return failed, nil
}

func (s *Service) respond(ctx context.Context, owner string, conversation int64) error {
	history, err := s.ListMessages(ctx, owner, conversation)
	if err != nil {
		return err
	}
	reply, err := s.responder.Reply(ctx, history)
	if err != nil {
		return err
	}
	if strings.TrimSpace(reply) == "" {
		return errors.New("assistant returned an empty reply")
	}
	return s.insertMessage(ctx, owner, conversation, "assistant", reply)
}

func (s *Service) insertMessage(ctx context.Context, owner string, conversation int64, role, content string) error {
	result, err := s.write.ExecContext(ctx, `INSERT INTO messages(conversation_id, role, content) SELECT id, ?, ? FROM conversations WHERE id = ? AND owner = ?`, role, strings.TrimSpace(content), conversation, owner)
	if err != nil {
		return err
	}
	affected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	if affected == 0 {
		return ErrConversationNotFound
	}
	return nil
}
