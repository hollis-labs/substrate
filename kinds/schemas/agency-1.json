{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agency/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "framework": {
      "const": "citadel"
    },
    "charter": {
      "type": "string",
      "minLength": 1
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "object",
            "properties": {
              "charter": {
                "type": "string",
                "minLength": 1
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 256
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authority": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "authority",
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 256
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authority": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "authority",
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 256
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authority": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "authority",
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 256
              },
              "launch_profile": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "object",
                    "properties": {
                      "authority": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uri": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "authority",
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reference",
                  "revision"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "charter",
              "roles"
            ],
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "properties": {
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "authority",
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "definition"
            ],
            "not": {
              "required": [
                "reference"
              ]
            }
          },
          {
            "required": [
              "reference"
            ],
            "not": {
              "required": [
                "definition"
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "authority",
          "kind",
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "framework",
    "charter",
    "cells"
  ],
  "additionalProperties": false
}
