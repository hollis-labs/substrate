{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "config/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "scope": {
      "enum": [
        "project",
        "service",
        "agent",
        "agency"
      ]
    },
    "settings": {
      "type": "object"
    },
    "secret_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "secret"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "authority",
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "authority",
          "kind",
          "id"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "target": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "project",
            "service",
            "agent",
            "agency"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authority",
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "settings_schema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        }
      },
      "required": [
        "type"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "scope",
    "settings",
    "target",
    "settings_schema"
  ],
  "additionalProperties": false
}
