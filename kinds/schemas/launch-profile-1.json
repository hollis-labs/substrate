{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "launch_profile/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "object",
          "properties": {
            "authority": {
              "const": "tether"
            },
            "kind": {
              "const": "launch_profile"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "authority",
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reference",
        "revision"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "authority",
          "kind",
          "id"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "source"
  ],
  "additionalProperties": false
}
